<UserControl x:Class="EndoscopyApp.Views.Controls.AiResultPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="360">
    <!-- DataContext: EndoscopyApp.ViewModels.AiAnalysisViewModel -->
    <UserControl.Resources>
        <DataTemplate x:Key="AiFindingTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Foreground="#2D3748" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PercentText}" Foreground="#2D3748" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Probability, Mode=OneWay}" Minimum="0" Maximum="1"
                             Height="8" Margin="0,4,0,0" Foreground="{Binding BarBrush}" Background="#EDF2F7" BorderThickness="0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <materialDesign:Card UniformCornerRadius="16" Background="White" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: title + Analyse button -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Brain" Width="24" Height="24" Foreground="#4C51BF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="AI Analysis" FontSize="18" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding AnalyseCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#4C51BF" Foreground="White" BorderBrush="Transparent"
                        materialDesign:ButtonAssist.CornerRadius="10" Height="36" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding AnalyseButtonText}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Loading the AI model -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding IsEngineLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Value="0"
                                     Width="18" Height="18" Foreground="#4C51BF" VerticalAlignment="Center"/>
                        <TextBlock Text="Loading AI model..." Foreground="#718096" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Engine unavailable -->
                    <Border Background="#F7FAFC" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"
                            Visibility="{Binding ShowEngineUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#718096" VerticalAlignment="Top" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding UnavailableMessage}" Foreground="#4A5568" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Busy -->
                    <StackPanel Margin="0,30" HorizontalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Value="0"
                                     Width="40" Height="40" Foreground="#4C51BF"/>
                        <TextBlock Text="Analysing image..." Foreground="#4A5568" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel Margin="0,30" HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="48" Height="48" Foreground="#CBD5E0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyStateText}" Foreground="#A0AEC0" FontWeight="SemiBold" Margin="0,10,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Result -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasResult}" Value="True"/>
                                            <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Status card -->
                        <Border Background="{Binding StatusBackgroundBrush}" BorderBrush="{Binding StatusAccentBrush}"
                                BorderThickness="4,0,0,0" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="{Binding StatusIcon}" Width="24" Height="24"
                                                         Foreground="{Binding StatusAccentBrush}" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="Bold"
                                               Foreground="{Binding StatusAccentBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#4A5568" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Findings -->
                        <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Findings" FontSize="14" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding TopFindings}" ItemTemplate="{StaticResource AiFindingTemplate}"/>
                            <ItemsControl ItemsSource="{Binding OtherFindings}" ItemTemplate="{StaticResource AiFindingTemplate}"
                                          Visibility="{Binding ShowAllFindings, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Command="{Binding ToggleShowAllCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Left" Padding="4,0" Height="30" Foreground="#4C51BF"
                                    Visibility="{Binding HasOtherFindings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ShowAllText}" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>

                        <!-- Heatmap toggle -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding CanShowHeatmap, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Command="{Binding ToggleHeatmapCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="10" Height="34" HorizontalAlignment="Left"
                                    Foreground="#4C51BF" BorderBrush="#4C51BF">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon VerticalAlignment="Center" Margin="0,0,6,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Eye"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowHeatmap}" Value="True">
                                                        <Setter Property="Kind" Value="EyeOff"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding HeatmapButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding HeatmapCaption}" Foreground="#718096" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Metadata -->
                        <TextBlock Text="{Binding MetadataText}" Foreground="#A0AEC0" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Mandatory disclaimer (always visible) -->
            <Border Grid.Row="2" Background="#EDF2F7" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Disclaimer}" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold"
                               FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>

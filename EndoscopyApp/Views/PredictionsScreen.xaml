<UserControl x:Class="EndoscopyApp.Views.PredictionsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EndoscopyApp.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PredictionsViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:PredictionsViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10" ColumnDefinitions="*,250">
        <!-- Left: Video/Image feed -->
        <Border Grid.Column="0" Background="Black" CornerRadius="5">
            <Image Source="{Binding SelectedImage}" Stretch="Uniform" />
        </Border>
        <!-- Right: Controls and results -->
        <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top" Spacing="10">
            <Button Content="Load Image" Command="{Binding LoadImageCommand}" Width="200" />
            <Button Content="Run Prediction" Command="{Binding PredictCommand}" Width="200" IsEnabled="{Binding CanPredict}" />
            <ProgressBar Height="20" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="Results:" FontWeight="Bold" />
            <ItemsControl ItemsSource="{Binding PredictionResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text=" : " />
                            <TextBlock Text="{Binding Confidence, StringFormat='{}{0:P2}'}" Foreground="Gray" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Disclaimer}" FontStyle="Italic" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
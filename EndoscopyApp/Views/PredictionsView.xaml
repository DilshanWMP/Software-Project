<UserControl x:Class="EndoscopyApp.Views.PredictionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:EndoscopyApp.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1024"
             Background="#F5F7FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NavigateBackCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="0" Width="40" Height="40" Margin="0,0,15,0">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="26" Height="26"/>
                </Button>
                <materialDesign:PackIcon Kind="Brain" Width="30" Height="30" Foreground="#4C51BF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="AI Analysis" FontSize="26" FontWeight="ExtraBold" Foreground="#1A202C" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ClearCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="0,0,10,0" Height="40" Foreground="#718096"
                        Visibility="{Binding HasImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding BrowseCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Choose Image..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body: image preview on the left, AI panel on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Image Card -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,20,0" UniformCornerRadius="16" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#EDF2F7" Padding="16,12">
                        <TextBlock Text="{Binding SelectedFileName}" FontWeight="SemiBold" Foreground="#4A5568" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Image Display Area -->
                    <Border Grid.Row="1" Background="#1A202C" Margin="12" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ImagePreview}" Stretch="Uniform"/>

                            <!-- AI heatmap overlay: same pixel size as the image + same Stretch, so it lines up exactly -->
                            <Image Source="{Binding Ai.HeatmapImage}" Stretch="Uniform" IsHitTestVisible="False"
                                   Visibility="{Binding Ai.ShowHeatmap, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Empty State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasImagePreview, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="ImageOutline" Width="64" Height="64" Foreground="#718096" HorizontalAlignment="Center"/>
                                <TextBlock Text="No image loaded" Foreground="#A0AEC0" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Choose Image...' to open an endoscopy image" Foreground="#718096" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Busy Overlay -->
                            <Border Background="#99000000" Visibility="{Binding Ai.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="48" Height="48" Foreground="White"/>
                                    <TextBlock Text="Analysing image..." Foreground="White" FontWeight="Bold" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Error banner -->
                    <Border Grid.Row="2" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1" CornerRadius="8" Margin="12,0,12,12" Padding="10"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#E53E3E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C53030" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- Right: shared AI panel (results are not saved on this screen) -->
            <controls:AiResultPanel Grid.Column="1" Width="360" DataContext="{Binding Ai}"/>
        </Grid>
    </Grid>
</UserControl>

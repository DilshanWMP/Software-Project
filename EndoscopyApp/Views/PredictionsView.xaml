<UserControl x:Class="EndoscopyApp.Views.PredictionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EndoscopyApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             Background="#F5F7FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NavigateBackCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Padding="0" Width="40" Height="40" Margin="0,0,15,0">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="26" Height="26"/>
                </Button>
                <materialDesign:PackIcon Kind="Brain" Width="30" Height="30" Foreground="#4C51BF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="AI Anomaly Predictions" FontSize="26" FontWeight="ExtraBold" Foreground="#1A202C" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding BrowseCommand}" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Margin="0,0,10,0" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Choose Image..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding AnalyzeCommand}" 
                        IsEnabled="{Binding CanAnalyze}"
                        Background="#4C51BF" Foreground="White"
                        BorderBrush="Transparent"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Height="40" Padding="20,0"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Analyze Snapshot" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body: Two Columns (Preview on Left, Results on Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="350"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Snapshot Card -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,15,0" UniformCornerRadius="16" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#EDF2F7" Padding="16,12">
                        <TextBlock Text="{Binding SelectedFileName}" FontWeight="SemiBold" Foreground="#4A5568" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Image Display Area -->
                    <Border Grid.Row="1" Background="#1A202C" Margin="12" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Empty State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImagePreview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="ImageOutline" Width="64" Height="64" Foreground="#718096" HorizontalAlignment="Center"/>
                                <TextBlock Text="No snapshot loaded" Foreground="#A0AEC0" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Choose Image...' to upload a laparoscopy frame" Foreground="#718096" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Loading Overlay -->
                            <Border Background="#99000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="48" Height="48" Foreground="White"/>
                                    <TextBlock Text="Running inference..." Foreground="White" FontWeight="Bold" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Error message banner if any -->
                    <Border Grid.Row="2" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1" CornerRadius="8" Margin="12,0,12,12" Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#E53E3E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C53030" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- Right: Results Card -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="16" Background="White" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Analysis Results" FontSize="18" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,15"/>

                    <!-- No Results Placeholder -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResult}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="50" Height="50" Foreground="#CBD5E0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Awaiting analysis" Foreground="#A0AEC0" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select an image and click 'Analyze Snapshot'" Foreground="#CBD5E0" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Analysis Output Panel -->
                    <ScrollViewer Grid.Row="1" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Top Finding Header Card -->
                            <Border CornerRadius="12" Padding="16" Margin="0,0,0,15" Background="#EDF2F7">
                                <StackPanel>
                                    <TextBlock Text="TOP DETECTION" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Result.TopLabel}" FontSize="22" FontWeight="Bold" Foreground="#1A202C" VerticalAlignment="Center"/>
                                        <Border Margin="10,0,0,0" CornerRadius="6" Background="#ED8936" Padding="6,2" VerticalAlignment="Center"
                                                Visibility="{Binding Result.Uncertain, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="LOW CONFIDENCE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Result.Confidence, StringFormat='Confidence: {0:P1}'}" Foreground="#4A5568" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- Probabilities List -->
                            <TextBlock Text="Class Probabilities" FontSize="14" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding RankedProbabilities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#4A5568" VerticalAlignment="Center" FontWeight="Medium"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding Probability}" Maximum="1" Height="10" 
                                                         Foreground="#4C51BF" Background="#EDF2F7" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PercentageText}" Foreground="#2D3748" 
                                                       FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Inference Metadata -->
                            <Separator Margin="0,15,0,15" Background="#E2E8F0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Model Version" FontSize="11" Foreground="#A0AEC0"/>
                                    <TextBlock Text="{Binding Result.ModelVersion}" FontWeight="SemiBold" Foreground="#4A5568"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Inference Latency" FontSize="11" Foreground="#A0AEC0"/>
                                    <TextBlock Text="{Binding Result.InferenceTimeMs, StringFormat='{}{0:F1} ms'}" FontWeight="SemiBold" Foreground="#4A5568"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Mandatory Disclaimer Footer -->
                    <Border Grid.Row="2" Background="#EDF2F7" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Disclaimer}" Foreground="#4A5568" FontSize="11" FontStyle="Italic" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
